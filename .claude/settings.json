{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "ask": [
      "Edit(.env)",
      "Write(.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/eslint-hook.sh",
            "statusMessage": "بررسی ESLint ...",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
