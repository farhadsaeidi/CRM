# نمونهٔ فایل تنظیمات — این را به .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env
# کلید جدید برای پروداکشن:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# دیتابیس
# روی این ماشین دو نسخهٔ پستگرس ویندوز نصب است: ۱۷ روی ۵۴۳۲ و ۱۸ روی ۵۴۳۳.
# دیتابیس CRM روی ۵۴۳۳ است. اگر پورت اشتباه باشد خطای
# «database "CRM" does not exist» می‌گیرید.
DB_NAME=CRM
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# پیامک (کاوه‌نگار)
# SMS_DEV_MODE=True یعنی پیامک واقعاً ارسال نمی‌شود و فقط در SMSLog ثبت می‌گردد.
# برای پروداکشن باید False شود، وگرنه کاربران هیچ کد تاییدی دریافت نمی‌کنند.
# الگوهای لازم در پنل کاوه‌نگار: «crm» برای کد ورود و «crm-forget-pass» برای رمز جدید.
SMS_DEV_MODE=True
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=1000009999090

# دستیارِ گفتگو
#
# قرارداد سازگار با OpenAI است، پس عوض کردنِ ارائه‌دهنده فقط همین چند خط است.
#
# الف) مدلِ محلی با اولاما — رایگان، ولی روی CPU هر پاسخ چند دقیقه طول می‌کشد:
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_API_KEY=ollama          # اولاما نگاهش نمی‌کند، ولی خالی نباید بماند
#   LLM_MODEL=qwen2.5:7b
#
# ب) OpenRouter — چند ثانیه‌ای و در انتخابِ ابزار به‌مراتب دقیق‌تر:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-v1-...    # از openrouter.ai/keys
#   LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# پراکسی برای رسیدن به مدل. خالی بگذارید مگر شبکه‌تان دسترسیِ مستقیم ندهد:
# میزبانِ محلی خودکار بدونِ پراکسی می‌رود و بقیه از متغیرهای محیط می‌خوانند.
LLM_PROXY=

# دامنه‌های مجاز برای درخواست‌های تغییردهنده (فقط وقتی DEBUG=False)
CSRF_TRUSTED_ORIGINS=https://example.com
