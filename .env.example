# نمونهٔ فایل تنظیمات — این را به .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env
# کلید جدید برای پروداکشن:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# دیتابیس
# روی این ماشین دو نسخهٔ پستگرس ویندوز نصب است: ۱۷ روی ۵۴۳۲ و ۱۸ روی ۵۴۳۳.
# دیتابیس CRM روی ۵۴۳۳ است. اگر پورت اشتباه باشد خطای
# «database "CRM" does not exist» می‌گیرید.
DB_NAME=CRM
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# دامنه‌های مجاز برای درخواست‌های تغییردهنده (فقط وقتی DEBUG=False)
CSRF_TRUSTED_ORIGINS=https://example.com
